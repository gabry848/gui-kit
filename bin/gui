#!/bin/sh
# Launcher for the gui CLI; follows symlinks so it can live in ~/.local/bin.
self=$0
while [ -L "$self" ]; do
	target=$(readlink "$self")
	case $target in /*) self=$target ;; *) self=$(dirname "$self")/$target ;; esac
done
# --no-env-file: a .env in the current folder must not reach the CLI, which hands its environment to apps.
exec bun --no-env-file "$(cd "$(dirname "$self")/.." && pwd)/src/cli/main.ts" "$@"
