{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun",
      "node"
    ],
    "paths": {
      "gui-kit": [
        "./src/kit/index.ts"
      ],
      "gui-kit/testing": [
        "./src/kit/testing.tsx"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
