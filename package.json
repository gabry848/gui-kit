{
  "name": "gui-kit",
  "version": "0.1.0",
  "description": "Full-screen terminal apps for AI agents and people: an Ink 8 kit with Vim keys, components and graphics, and a CLI that runs saved apps in a sandbox.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabry848/gui-kit.git"
  },
  "keywords": [
    "terminal",
    "tui",
    "ink",
    "react",
    "bun",
    "cli",
    "vim",
    "sandbox",
    "ai-agents"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "bun src/apps/demo/main.tsx",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "gui": "bun src/cli/main.ts"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0",
    "ink": "8.0.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "gui": "./bin/gui"
  },
  "main": "./src/kit/index.ts"
}
